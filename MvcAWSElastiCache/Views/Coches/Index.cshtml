@model IEnumerable<MvcAWSElastiCache.Models.Coche>

@{
    ViewData["Title"] = "Coches";
}

<h1 class="mb-4">Listado de Coches</h1>

<div class="mb-4">
    <a asp-action="Favoritos" class="btn btn-warning">❤️ Ver mis favoritos</a>
</div>

@if (Model != null)
{
    <div class="row row-cols-1 row-cols-md-3 g-4">
        @foreach (var item in Model) {
            <div class="col">
                <div class="card h-100 shadow-sm">
                    <img src="@item.Imagen" class="card-img-top" alt="@item.Marca @item.Modelo" style="height: 200px; object-fit: cover;">
                    <div class="card-body">
                        <h5 class="card-title">@item.Marca</h5>
                        <p class="card-text">@item.Modelo</p>
                    </div>
                    <div class="card-footer bg-transparent border-top-0 text-center pb-3">
                        <a asp-action="SeleccionarFavorito" asp-route-id="@item.IdCoche" class="btn btn-outline-warning w-100 mb-2">⭐ Añadir a Favoritos</a>
                        <a asp-action="Details" asp-route-id="@item.IdCoche" class="btn btn-outline-primary w-100">Ver Detalles</a>
                    </div>
                </div>
            </div>
        }
    </div>
    
}
