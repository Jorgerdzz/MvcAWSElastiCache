@model MvcAWSElastiCache.Models.Coche

@{
    ViewData["Title"] = "Detalles de " + Model.Marca;
}

<div class="container mt-4">
    <div class="card shadow">
        <div class="row g-0">
            <div class="col-md-6">
                <img src="@Model.Imagen" class="img-fluid rounded-start h-100" alt="@Model.Marca @Model.Modelo" style="object-fit: cover;">
            </div>
            <div class="col-md-6">
                <div class="card-body d-flex flex-column h-100 justify-content-center p-5">
                    <h1 class="card-title display-5 fw-bold mb-3 text-primary">@Model.Marca</h1>
                    <h3 class="card-subtitle mb-4 text-muted">@Model.Modelo</h3>

                    <div class="mt-auto pt-4 border-top">
                        <a asp-action="Index" class="btn btn-secondary btn-lg w-100">
                            <i class="bi bi-arrow-left me-2"></i>Volver a la lista
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
